# Settings for `docker compose up` (copy to .env next to docker-compose.yml).
# All of them are read when the containers start: change a value, then `docker compose up -d` (no rebuild).
# APP_ENV is the only build-time setting (see below).

# Public address of the site, used for every link in emails (https://<address>/sign/<token>).
PUBLIC_APP_URL=http://localhost:3100

# Backend mode. production refuses to start when MAIL_REDIRECT_TO is set; use test for a test environment.
NODE_ENV=production

# Secret for signing login tokens. Use a long random string outside local demos.
JWT_SECRET=demo-only-secret-change-me-please

# --- Email (SMTP). The defaults send everything to the local Mailpit (web UI on http://localhost:8025). ---
# SMTP server host name and port.
SMTP_HOST=mailpit
SMTP_PORT=1025
# true = TLS from the start (usually port 465); false = plain, upgraded with STARTTLS when the server offers it (587).
SMTP_SECURE=false
# SMTP login; leave empty for servers without authentication (Mailpit).
SMTP_USER=
SMTP_PASSWORD=
# Sender shown in the emails.
MAIL_FROM="Paperwork Studio <no-reply@academy.am>"
# Test environments only: when set, EVERY email goes to this one address instead of the real recipient, with
# "Original recipient: <name> <email>" on the first line. Not allowed with NODE_ENV=production (the backend refuses to start).
MAIL_REDIRECT_TO=

# Build-time: test = demo logins shown on the login page; production = hidden. Changing it needs `docker compose up --build`.
APP_ENV=test
