# --- Server ---
PORT=4000
NODE_ENV=development
# Public address of the site; every link in emails (/sign/<token>) is built from it. Restart to apply.
PUBLIC_APP_URL=http://localhost:3100
CORS_ORIGIN=http://localhost:3100
APP_TIMEZONE=Asia/Yerevan

# --- Database / Redis (host ports used by docker-compose) ---
DATABASE_URL=postgresql://paperwork:paperwork@localhost:5433/paperwork?schema=public
REDIS_URL=redis://localhost:6380

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# --- Files ---
STORAGE_DIR=./storage

# --- PDF conversion (Gotenberg) ---
GOTENBERG_URL=http://localhost:3010

# --- Email. Defaults = SMTP to the local Mailpit (web UI http://localhost:8025) ---
# How email is sent: smtp (default; Mailpit locally or any SMTP server) | brevo | resend (HTTP APIs over HTTPS,
# for hosts that block outbound SMTP). With brevo or resend the SMTP_* settings are ignored.
MAIL_TRANSPORT=smtp
# Brevo API key (only for MAIL_TRANSPORT=brevo). Secret: never commit a real key. Never written to the logs.
BREVO_API_KEY=
# Resend API key (only for MAIL_TRANSPORT=resend; starts with re_). Secret: never commit a real key. Never logged.
# Without a verified domain, Resend only sends from onboarding@resend.dev and only to your own Resend account address.
RESEND_API_KEY=
SMTP_HOST=localhost
SMTP_PORT=1025
# true = TLS from the start (usually port 465); false = plain, upgraded with STARTTLS when offered (587)
SMTP_SECURE=false
# SMTP login; leave empty for servers without authentication (Mailpit)
SMTP_USER=
SMTP_PASSWORD=
# Sender shown in the emails (name + address; with brevo / resend the address must be verified there)
MAIL_FROM="Paperwork Studio <no-reply@academy.am>"
# Test environments only: EVERY email goes to this address instead of the real recipient, with
# "Original recipient: <name> <email>" on the first line. Refused with NODE_ENV=production.
MAIL_REDIRECT_TO=

# --- Signatures / reminders ---
SIGN_LINK_TTL_DAYS=14
# Days after sending when an automatic reminder is due (comma-separated)
REMINDER_SCHEDULE_DAYS=2,5
# How often the reminder job runs (cron, UTC)
REMINDER_CRON=0 * * * *
# Concurrent docx->pdf conversions per batch
GENERATION_CONCURRENCY=4
