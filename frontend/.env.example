# The browser calls relative /api on the site's own address; Next.js proxies it to this backend.
# Backend as seen from the Next.js server (not from the browser). Read when `next dev` / `next build` starts.
BACKEND_URL=http://localhost:4000
# development | test | production. Demo logins on the login page are shown only when this is NOT production.
NEXT_PUBLIC_APP_ENV=development
